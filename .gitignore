# Python
.venv/
__pycache__/

# Steering vectors: model-specific, rebuilt with build_risk_vec.py
*.pt
# ...but DO commit the steering vectors. They are 15-20 KB, and shipping
# them means a fresh clone does not have to rebuild them (which needs the model
# downloaded first). Rebuild if you change MODEL, describe(), or the layer.
!risk_vec_*.pt

# Arduino / host-test build artefacts
arduino/test/test_protocol
arduino/test/test_protocol.exe
arduino/**/build/
*.o
